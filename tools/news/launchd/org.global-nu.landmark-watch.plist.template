<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  global-nu — the hourly landmark check. See tools/news/landmark.py.

  The daily run fires once, at a fixed hour, and the 2026 Nobel prize was
  announced four hours after that morning's run. This agent fetches the feeds
  only and starts the full pipeline (build + push) only when a fresh landmark
  is not yet on the live site; every other hour it exits 0 without a line in
  the log.

  StartInterval, not a calendar slot: launchd does not make up a missed slot
  after sleep, an interval keeps firing after wake. No RunAtLoad and no
  stdout sink, for the reasons in org.global-nu.daily.plist.template.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.global-nu.landmark-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>tools.news.pipeline</string>
        <string>--quiet</string>
        <string>--if-landmark</string>
    </array>

    <!-- python -m resolves tools.news.pipeline relative to the working
         directory, so this is load-bearing, not cosmetic. -->
    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <key>StartInterval</key>
    <integer>3600</integer>

    <!-- Deliberately absent: RunAtLoad. See the note above. -->

    <!-- Deliberately absent: StandardOutPath and StandardErrorPath. They used
         to point at __ROOT__/var/news/logs/launchd.log, and on 24 August 2026
         that stopped the site for two days.

         The mechanism: once a sandboxed application has opened a file under a
         protected directory — and ~/Desktop is protected exactly as
         ~/Documents is — macOS stamps com.apple.macl on it. From then on
         xpcproxy cannot open that file to redirect the job's output, and it
         kills the job at spawn with exit 78 (EX_CONFIG), before python runs.
         Nothing is written anywhere: no line in news.log, no line in
         launchd.log, and `launchctl list` shows the agent loaded and healthy.
         The failure is indistinguishable from an agent that never fired.

         Verified on 26 August 2026: `xattr` on that file returned
         com.apple.macl, and launchd's own record read
         `last exit code = 78: EX_CONFIG`.

         Nothing is lost by dropping these. The pipeline writes news.log
         itself through common.get_logger, and that file is unaffected — a
         program opening its own log is not xpcproxy trying to open one before
         the program exists. -->

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Background: lower I/O and CPU priority, and no effect on App Nap for
         foreground apps. The daily run is never urgent. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>

    <key>LowPriorityIO</key>
    <true/>

    <!-- Seconds between SIGTERM and SIGKILL when launchd stops the job, e.g.
         at logout or when the installer boots it out. Long enough for the
         pipeline to release var/news/run.lock on its way down. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
</dict>
</plist>
