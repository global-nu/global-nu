<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  global-nu — the daily run.

  Template. install-launchagents.sh fills in the ROOT, PYTHON, HOUR, MINUTE
  and HOME placeholders and writes the result to
  ~/Library/LaunchAgents/org.global-nu.daily.plist.
  Do not edit the installed copy: re-run the installer instead, so the hour and
  minute keep coming from tools/news/config.yaml.

  Two decisions worth stating, because both have bitten this kind of job:

  * No RunAtLoad. The agent must fire at its scheduled time and at no other
    moment. With RunAtLoad, every login, every installer re-run and every
    `launchctl bootstrap` would start a full pipeline — an AI call and three
    rewritten pages. Installing something must never rewrite something.

  * An explicit PATH. A LaunchAgent inherits almost nothing: not the login
    shell, not ~/.zshrc, not the PATH a Terminal has. The synthesis step
    shells out to the `claude` CLI, which lives in ~/.local/bin, and Homebrew
    lives in /opt/homebrew/bin. Without the PATH below the job runs, fetches
    everything, and fails at the one step that needs a binary — the single
    most likely cause of a silent daily failure.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.global-nu.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>tools.news.pipeline</string>
        <string>--quiet</string>
    </array>

    <!-- python -m resolves tools.news.pipeline relative to the working
         directory, so this is load-bearing, not cosmetic. -->
    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>__HOUR__</integer>
        <key>Minute</key>
        <integer>__MINUTE__</integer>
    </dict>

    <!-- Deliberately absent: RunAtLoad. See the note above. -->

    <key>StandardOutPath</key>
    <string>__ROOT__/var/news/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/var/news/logs/launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <!-- Background: lower I/O and CPU priority, and no effect on App Nap for
         foreground apps. The daily run is never urgent. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>

    <key>LowPriorityIO</key>
    <true/>

    <!-- Seconds between SIGTERM and SIGKILL when launchd stops the job, e.g.
         at logout or when the installer boots it out. Long enough for the
         pipeline to release var/news/run.lock on its way down. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
</dict>
</plist>
