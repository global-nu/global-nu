# Build caches and local noise — never the site output: site/ is what
# GitHub Pages will serve.
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.idea/
var/
*.log
.mypy_cache/
node_modules/
node_modules/
package-lock.json
preview/
var/photo-candidates/

# Unpublished releases and anything built from them. Neither may ever reach
# the public repository: the site is built from site/, and a draft build goes
# somewhere else on purpose.
drafts/
site-draft/
